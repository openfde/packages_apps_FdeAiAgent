<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================================
     FDE AI Agent — 五层架构界面（三栏布局）
       左栏 「智能体配置」
       中栏 「执行流程 SVG 状态面板」（WebView 渲染 SVG）+ 错误提示条
       右栏 「运行日志」控制台
     所有文案均来自 @string/…，自动适配中英文与深色模式（values-night）。
     =================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_window_bg"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/pc_header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:visibility="gone"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/app_name"
            android:textColor="@color/pc_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/tv_subtitle"
            android:textColor="@color/pc_text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pc_divider" />

    <!-- 主体：三栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- ============ 左栏：智能体配置 ============ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp">


            <!-- AI 连接配置（供应商 / API Key / 模型 / Base URL）已移入 ConfigActivity，
                 首页右上角「⚙ 配置」入口进入设置。 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="right"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/status_ready"
                    android:textColor="@color/pc_primary"
                    android:textSize="12sp"
                    tools:text="@string/status_ready" />


                <Button
                    android:id="@+id/btnConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    android:text="@string/home_config_entry"
                    android:textColor="@color/pc_text_regular"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnGrantFunctionPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_feature_desc"
                    android:textColor="@color/pc_text_regular"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_clear_log"
                    android:textColor="@color/pc_text_regular"
                    android:textSize="12sp" />
            </LinearLayout>


            <WebView
                android:id="@+id/svgStateView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/pc_window_bg" />



            <EditText
                android:id="@+id/editAgentPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:maxHeight="300dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/hint_agent_prompt"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textColor="@color/pc_text_primary"
                android:textColorHint="@color/pc_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:text="@string/label_voice_input"
                android:textAppearance="@style/TextAppearance.PcLabel" />

            <Button
                android:id="@+id/btnVoiceInput"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:text="@string/btn_voice_input"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/chkAutoRun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="@string/chk_auto_run"
                    android:textColor="@color/pc_text_regular"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvVoiceStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:maxLines="1"
                    android:text="@string/voice_status_default"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/available_skills"
                android:visibility="gone"
                android:textColor="@color/pc_text_secondary"
                android:textSize="11sp" />



            <Button
                android:id="@+id/btnRunAgent"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:text="@string/btn_run_agent"
                android:layout_marginTop="16dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOpenGallery"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_open_gallery"
                    android:textColor="@color/pc_text_regular"
                    android:textSize="12sp" />


            </LinearLayout>

            <!-- 打开设置页：选择页面 key + 触发跨应用 AppFunction（com.android.settings.openSettingsPage） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spSettingsPage"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:spinnerMode="dropdown" />

                <Button
                    android:id="@+id/btnOpenSettings"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_open_settings"
                    android:textColor="@color/pc_text_regular"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <!-- ============ 中栏：SVG 状态面板 ============ -->
        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:background="@drawable/bg_console"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_exec_flow"
                    android:textAppearance="@style/TextAppearance.PcSectionTitle" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/flow_subtitle"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                android:background="@color/pc_divider" />


            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:fillViewport="true"
                android:paddingVertical="14dp"
                android:scrollbars="vertical">


            <TextView
                android:id="@+id/tvAgentLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/pc_console_text"
                android:scrollHorizontally="false"
                android:background="@drawable/bg_console"
                android:text="@string/log_waiting"
                android:textIsSelectable="true"
                android:textSize="13sp" />
            </ScrollView>

            <!-- 错误提示条（由执行事件驱动，默认隐藏） -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_error_banner"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textColor="@color/pc_error_text"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="@string/error_banner_sample"
                tools:visibility="visible" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <!-- ============ 右栏：运行日志控制台 ============ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/tvModelInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/model_info_default"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/pc_divider" />


        </LinearLayout>
    </LinearLayout>
</LinearLayout>
