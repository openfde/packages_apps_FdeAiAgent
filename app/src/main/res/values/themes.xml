<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- FDE 桌面(PC)风格：浅色窗口，无 ActionBar，Element-UI 配色 -->
    <style name="Theme.FdeDownload" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pc_window_bg</item>
        <item name="android:colorPrimary">@color/pc_primary</item>
        <item name="android:colorPrimaryDark">@color/pc_primary</item>
        <item name="android:colorAccent">@color/pc_primary</item>
        <item name="android:statusBarColor">@color/pc_header_bg</item>
        <item name="android:navigationBarColor">@color/pc_window_bg</item>
        <item name="android:textColorPrimary">@color/pc_text_primary</item>
        <item name="android:textColorSecondary">@color/pc_text_secondary</item>
        <item name="android:textColorHint">@color/pc_text_secondary</item>
    </style>

    <!-- 面板章节标题 -->
    <style name="TextAppearance.PcSectionTitle" parent="@android:style/TextAppearance.Material">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/pc_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 表单项标签 -->
    <style name="TextAppearance.PcLabel" parent="@android:style/TextAppearance.Material.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/pc_text_regular</item>
    </style>
</resources>
