<?xml version="1.0" encoding="utf-8"?>
<!-- 次级操作按钮：白底 + 细边框，悬停 / 按下时着色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_panel_border" />
            <stroke
                android:width="1dp"
                android:color="@color/pc_input_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_primary_light" />
            <stroke
                android:width="1dp"
                android:color="@color/pc_primary" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/pc_input_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
