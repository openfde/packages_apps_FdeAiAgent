<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================================
     功能说明页 —— 用独立的 Activity 展示本智能体的功能总览与使用方法。
     顶栏（返回按钮）+ 可滚动内容区；每个功能介绍后单独换行，便于阅读。
     画面风格与首页 / ConfigActivity 保持一致（PC 桌面风、深色模式适配）。
     =================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_window_bg"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/pc_header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/feature_desc_title"
            android:textColor="@color/pc_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnFeatureDescBack"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_secondary"
            android:stateListAnimator="@null"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/config_back"
            android:textColor="@color/pc_text_regular"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pc_divider" />

    <!-- 内容区：可滚动展示功能说明，每个功能块之间用空行分隔 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvFeatureDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="880dp"
                android:background="@drawable/bg_panel"
                android:lineSpacingExtra="4dp"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp"
                android:text="@string/feature_summary"
                android:textColor="@color/pc_text_primary"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
